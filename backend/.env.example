# ==============================================================================
# KAVACH 1.0 CONFIGURATION — 100% FREE & ZERO-BILLING STACK (PRIMARY)
# ==============================================================================

# ---------- Primary AI Reasoning (100% Free - No Credit Card Needed) ----------
# Get a free key in 30 seconds at https://console.groq.com/keys (Sign in with Google/GitHub)
# No billing account, no credit card, and no payment verification required.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Retry model when the main one is rate-limited (separate quota on Groq)
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=12

# ---------- Local Database (100% Free & Zero Cloud Bills) ----------
# Leave DATABASE_URL blank to store everything in local SQLite (backend/data/).
# For cloud deployment with free-tier: paste a free Supabase or Neon PostgreSQL URI.
DATABASE_URL=

# 0 for real-world production safety. 1 enables demo simulation endpoints.
KAVACH_DEMO=0

# ---------- Real SOS & Emergency Dispatch (Free Channels) ----------
# Free Telegram bot token from @BotFather (Search @BotFather on Telegram -> /newbot)
TELEGRAM_BOT_TOKEN=
# Free Email backup via Gmail App Password (Google Account -> Security -> 2-Step -> App passwords)
SMTP_USER=
SMTP_PASSWORD=
# Proximity radius in metres for nearby community first-responders (default: 3000m = 3km)
SOS_RADIUS_M=3000
# Optional public domain or tunnel URL (leave blank to auto-detect from incoming request)
PUBLIC_URL=

# ==============================================================================
# OPTIONAL SERVICES (Leave blank unless you specifically configure them)
# ==============================================================================
# Free Gemini key from https://aistudio.google.com/ (No GCP billing card required on AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Maps default to free OpenStreetMap. If you ever have a Google Maps API key, paste here:
GOOGLE_MAPS_API_KEY=

# Google OAuth Client ID for Continue with Google (optional):
GOOGLE_CLIENT_ID=
