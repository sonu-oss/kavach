# Copy to backend/.env and fill in. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high for gpt-oss models; leave unset for non-reasoning models
# GROQ_REASONING_EFFORT=low
# Retry model when the main one is rate-limited (separate quota on Groq)
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Seconds before the Groq call is abandoned and the keyword result is used
GROQ_TIMEOUT=12

# 1 enables the Vault's "simulate tampering" / "reset" demo endpoints. Set 0 outside demos.
KAVACH_DEMO=1

# ---------- Real SOS alerts ----------
# Telegram bot token from @BotFather (Telegram → @BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
# Email backup via Gmail: your address + an App Password (Google Account → Security → App passwords)
SMTP_USER=
SMTP_PASSWORD=
# Responders within this many metres of her get alerted
SOS_RADIUS_M=3000
# Optional: public https address used in links sent out (blank = taken from the request)
PUBLIC_URL=
